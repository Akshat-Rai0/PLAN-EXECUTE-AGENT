ANTHROPIC_API_KEY=
TAVILY_API_KEY=
SANDBOX_TIMEOUT_SECONDS=15
SANDBOX_MAX_MEMORY_MB=256
OUTBOUND_DOMAIN_ALLOWLIST=api.tavily.com
LLM_PROVIDER=openrouter  # or "groq" / "ollama" for local development
OLLAMA_MODEL= gemma4:latest
CLAUDE_MODEL = claude-sonnet-4.6
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b 
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Browser Use uses OpenRouter's google/gemma-4-31b-it:free in text-only mode.
BROWSER_USE_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
BROWSER_USE_MAX_STEPS=25
BROWSER_USE_MAX_FAILURES=3
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...your key...
LANGCHAIN_PROJECT=plan-execute-agent

# API Server Security & CORS Configuration
API_SECRET_KEY=  # Optional: set a strong secret to require 'Authorization: Bearer <key>' on POST /runs & /interrupt
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
ALLOW_ALL_ORIGINS=false
